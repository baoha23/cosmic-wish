# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets
*.env
*.env.local
*.env.production
backend/supabase/.env.local

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# OS
Thumbs.db

# Local tool state (supabase CLI, etc.)
.local/

# Generated icons (kept ones are in assets/icons/)
# android/app/src/main/res/mipmap-*/ic_launcher.png are generated by flutter_launcher_icons

# Build outputs / dev artifacts
*.apk
*.aab
flutter_*.log
*.iml

# Loose screenshots at project root (keep ones inside docs/screenshots/)
/*.png
!/assets/icons/*.png
!/assets/images/*.png
!/docs/screenshots/*.png
